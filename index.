<!doctype html>
<html lang="ko">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <meta name="theme-color" content="#f4efed" />
  <title>꽃편지</title>
  <style>
    :root{
      --bg:#f4efed;
      --panel:#f8f4f2;
      --card:#f5f1ef;
      --ink:#2e2a29;
      --muted:#7b6f70;
      --rose:#d98b97;
      --rose-deep:#c96e80;
      --rose-light:#f8dfe6;
      --line:#e7dfe0;
      --paper:#efe9e4;
      --button:#d38a96;
      --shadow:rgba(70,42,52,.08);
    }

    *{ box-sizing:border-box; }
    html,body{ height:100%; }
    body{
      margin:0;
      background:var(--bg);
      color:var(--ink);
      font-family:-apple-system,BlinkMacSystemFont,"Segoe UI","Apple SD Gothic Neo","Noto Sans KR",sans-serif;
      display:flex;
      justify-content:center;
      align-items:flex-start;
      -webkit-tap-highlight-color:transparent;
    }

    .phone{
      width:100%;
      max-width:480px;
      min-height:100vh;
      background:var(--bg);
      padding:18px 18px 26px;
      position:relative;
    }

    .statusbar{
      display:flex;
      justify-content:space-between;
      align-items:center;
      height:38px;
      padding:0 4px 0 2px;
      font-weight:700;
      color:#1d1d1d;
      letter-spacing:-0.04em;
    }
    .time{ font-size:28px; }
    .signal{
      display:flex;
      align-items:center;
      gap:10px;
      font-size:14px;
      font-weight:700;
      color:#1a1a1a;
    }
    .icons{
      display:flex;
      align-items:center;
      gap:8px;
      font-size:15px;
    }
    .bars{
      width:22px;
      display:flex;
      align-items:flex-end;
      gap:2px;
      height:12px;
    }
    .bars span{
      display:block;
      width:3px;
      border-radius:2px;
      background:#1d1d1d;
    }
    .bars span:nth-child(1){ height:5px; }
    .bars span:nth-child(2){ height:8px; }
    .bars span:nth-child(3){ height:11px; }
    .bars span:nth-child(4){ height:12px; }

    .top-actions{
      margin-top:10px;
      display:flex;
      align-items:center;
      justify-content:space-between;
      padding:0 8px 0 12px;
    }

    .close-btn{
      width:58px;
      height:58px;
      border-radius:50%;
      border:1.5px solid rgba(24,24,24,.4);
      background:rgba(255,255,255,.06);
      display:grid;
      place-items:center;
      font-size:42px;
      color:#1f1f1f;
      line-height:1;
      font-weight:300;
    }

    .nav-group{
      display:flex;
      align-items:center;
      gap:12px;
      padding:0 8px;
    }
    .pill{
      width:58px;
      height:58px;
      border-radius:50%;
      background:rgba(255,255,255,.25);
      border:1.5px solid rgba(40,36,35,.18);
      display:grid;
      place-items:center;
      color:#1a1a1a;
      font-size:28px;
      box-shadow:0 1px 0 rgba(255,255,255,.25) inset;
    }
    .pill.send{
      font-size:28px;
      transform:translateY(1px);
    }
    .pill.more{
      font-size:28px;
      letter-spacing:-2px;
      font-weight:300;
    }

    .title-wrap{
      margin-top:26px;
      padding:0 6px 0 8px;
    }
    .title{
      display:flex;
      align-items:center;
      gap:10px;
      margin-bottom:6px;
      font-size:28px;
      font-weight:700;
      letter-spacing:-0.05em;
    }
    .title .flower{
      display:inline-block;
      width:22px;
      height:22px;
      border-radius:50%;
      position:relative;
      background:linear-gradient(135deg,#f8a9b7,#d86d84);
      box-shadow:0 0 0 2px rgba(220,128,143,.20);
    }
    .title .flower::before,
    .title .flower::after{
      content:"";
      position:absolute;
      inset:0;
      border-radius:50%;
      background:transparent;
      box-shadow:
        0 -8px 0 0 #d16e82,
        0 8px 0 0 #d16e82,
        -8px 0 0 0 #d16e82,
        8px 0 0 0 #d16e82;
      transform:scale(0.7);
    }
    .subtitle{
      margin:0;
      font-size:17px;
      color:#6f5d63;
      letter-spacing:-0.02em;
      line-height:1.5;
      font-weight:500;
    }

    .card{
      margin-top:18px;
      background:rgba(255,255,255,0.12);
      border-radius:24px;
      padding:0;
      overflow:hidden;
      border:1px solid rgba(120,96,101,.12);
      box-shadow:0 10px 24px rgba(96,72,78,.02);
    }

    .visual{
      position:relative;
      height:320px;
      background:#ece6e4;
      overflow:hidden;
      border-radius:24px 24px 0 0;
    }

    .visual svg{
      width:100%;
      height:100%;
      display:block;
      background:linear-gradient(#f2eeeb,#efe8e6);
    }

    .text-box{
      padding:26px 18px 18px;
      background:rgba(255,255,255,0.12);
    }
    .headline{
      margin:0 0 14px;
      font-size:29px;
      line-height:1.35;
      letter-spacing:-0.06em;
      font-weight:700;
      color:#2d2a2a;
    }
    .desc{
      margin:0;
      color:#5f5557;
      font-size:18px;
      line-height:1.7;
      letter-spacing:-0.02em;
      word-break:keep-all;
    }

    .cta{
      margin-top:22px;
      width:100%;
      height:68px;
      border:0;
      border-radius:18px;
      background:linear-gradient(180deg,var(--button),#cc828e);
      color:#fff;
      font-size:27px;
      font-weight:700;
      letter-spacing:-0.04em;
      box-shadow:0 12px 20px rgba(201,118,134,.18);
    }

    @media (min-width: 520px){
      body{
        padding:20px 0;
      }
      .phone{
        min-height:860px;
        border-radius:24px;
        box-shadow:0 10px 30px rgba(98,78,83,.05);
      }
    }
  </style>
</head>
<body>
  <div class="phone">
    <div class="statusbar">
      <div class="time">11:15</div>
      <div class="signal">
        <div class="icons">
          <div class="bars" aria-hidden="true">
            <span></span><span></span><span></span><span></span>
          </div>
          <span>5G</span>
        </div>
        <span>38%</span>
      </div>
    </div>

    <div class="top-actions">
      <div class="close-btn" aria-label="닫기">×</div>
      <div class="nav-group">
        <div class="pill" aria-label="검색">⌕</div>
        <div class="pill send" aria-label="보내기">↑</div>
        <div class="pill more" aria-label="더보기">⋯</div>
      </div>
    </div>

    <div class="title-wrap">
      <div class="title">
        <span class="flower" aria-hidden="true"></span>
        <span>꽃편지</span>
      </div>
      <p class="subtitle">꽃을 고르고, 마음을 적어 연인에게 보내요.</p>
    </div>

    <div class="card">
      <div class="visual" aria-label="꽃다발 이미지">
        <svg viewBox="0 0 800 420" xmlns="http://www.w3.org/2000/svg">
          <defs>
            <linearGradient id="paperGrad" x1="0" x2="1">
              <stop offset="0%" stop-color="#f3efeb"/>
              <stop offset="100%" stop-color="#e9e0dd"/>
            </linearGradient>
            <linearGradient id="roseGrad" x1="0" x2="1">
              <stop offset="0%" stop-color="#f7c3d1"/>
              <stop offset="100%" stop-color="#d98ca2"/>
            </linearGradient>
            <linearGradient id="leafGrad" x1="0" x2="1">
              <stop offset="0%" stop-color="#88a17a"/>
              <stop offset="100%" stop-color="#54715b"/>
            </linearGradient>
          </defs>

          <!-- wrap -->
          <path d="M50 270 C180 130, 300 60, 420 80 C612 96, 704 188, 758 282 L760 420 L70 420 Z"
                fill="url(#paperGrad)" opacity="0.9"/>
          <path d="M105 320 C250 220, 350 170, 466 190 C622 215, 682 275, 720 320 L720 420 L80 420 Z"
                fill="#f8f5f3" opacity="0.75"/>

          <!-- bouquet cluster -->
          <g opacity="0.98">
            <g transform="translate(160 150)">
              <circle cx="0" cy="0" r="28" fill="url(#roseGrad)"/>
              <circle cx="18" cy="-10" r="22" fill="url(#roseGrad)"/>
              <circle cx="-18" cy="-10" r="22" fill="url(#roseGrad)"/>
              <circle cx="4" cy="20" r="22" fill="url(#roseGrad)"/>
              <circle cx="-24" cy="18" r="20" fill="url(#roseGrad)"/>
              <circle cx="24" cy="20" r="20" fill="url(#roseGrad)"/>
              <circle cx="0" cy="38" r="18" fill="url(#roseGrad)"/>
            </g>

            <g transform="translate(250 165)">
              <circle cx="0" cy="0" r="26" fill="url(#roseGrad)"/>
              <circle cx="20" cy="-8" r="22" fill="url(#roseGrad)"/>
              <circle cx="-20" cy="-10" r="20" fill="url(#roseGrad)"/>
              <circle cx="5" cy="20" r="21" fill="url(#roseGrad)"/>
              <circle cx="-18" cy="18" r="18" fill="url(#roseGrad)"/>
              <circle cx="24" cy="18" r="18" fill="url(#roseGrad)"/>
            </g>

            <g transform="translate(355 145)">
              <circle cx="0" cy="0" r="28" fill="url(#roseGrad)"/>
              <circle cx="16" cy="-12" r="20" fill="url(#roseGrad)"/>
              <circle cx="-18" cy="-12" r="20" fill="url(#roseGrad)"/>
              <circle cx="-6" cy="22" r="20" fill="url(#roseGrad)"/>
              <circle cx="19" cy="18" r="18" fill="url(#roseGrad)"/>
              <circle cx="-22" cy="22" r="18" fill="url(#roseGrad)"/>
            </g>

            <g transform="translate(438 170)">
              <circle cx="0" cy="0" r="26" fill="url(#roseGrad)"/>
              <circle cx="18" cy="-8" r="20" fill="url(#roseGrad)"/>
              <circle cx="-18" cy="-10" r="18" fill="url(#roseGrad)"/>
              <circle cx="6" cy="22" r="20" fill="url(#roseGrad)"/>
              <circle cx="-18" cy="20" r="17" fill="url(#roseGrad)"/>
            </g>

            <g transform="translate(550 155)">
              <circle cx="0" cy="0" r="29" fill="url(#roseGrad)"/>
              <circle cx="20" cy="-12" r="22" fill="url(#roseGrad)"/>
              <circle cx="-18" cy="-12" r="22" fill="url(#roseGrad)"/>
              <circle cx="5" cy="22" r="22" fill="url(#roseGrad)"/>
              <circle cx="-20" cy="18" r="18" fill="url(#roseGrad)"/>
            </g>

            <g transform="translate(620 190)">
              <circle cx="0" cy="0" r="24" fill="url(#roseGrad)"/>
              <circle cx="18" cy="-10" r="18" fill="url(#roseGrad)"/>
              <circle cx="-18" cy="-8" r="18" fill="url(#roseGrad)"/>
              <circle cx="0" cy="18" r="18" fill="url(#roseGrad)"/>
            </g>

            <!-- leaves -->
            <g fill="url(#leafGrad)" opacity="0.9">
              <ellipse cx="170" cy="235" rx="20" ry="28" transform="rotate(-24 170 235)"/>
              <ellipse cx="210" cy="230" rx="18" ry="26" transform="rotate(24 210 230)"/>
              <ellipse cx="270" cy="255" rx="24" ry="30" transform="rotate(-30 270 255)"/>
              <ellipse cx="355" cy="255" rx="22" ry="30" transform="rotate(26 355 255)"/>
              <ellipse cx="470" cy="250" rx="24" ry="30" transform="rotate(-22 470 250)"/>
              <ellipse cx="560" cy="243" rx="22" ry="28" transform="rotate(20 560 243)"/>
            </g>

            <!-- small flowers -->
            <g fill="#f5f1ef">
              <circle cx="310" cy="118" r="7"/>
              <circle cx="330" cy="128" r="6"/>
              <circle cx="520" cy="132" r="8"/>
              <circle cx="540" cy="118" r="7"/>
              <circle cx="590" cy="120" r="6"/>
            </g>

            <!-- stems -->
            <g stroke="#9ea899" stroke-width="4" stroke-linecap="round" opacity="0.8">
              <path d="M240 245 L220 330"/>
              <path d="M350 255 L325 332"/>
              <path d="M445 245 L455 335"/>
              <path d="M525 250 L545 332"/>
              <path d="M610 260 L610 340"/>
            </g>
          </g>

          <!-- ribbon -->
          <path d="M305 368 C360 420, 430 420, 482 368" fill="none" stroke="#f2efee" stroke-width="18" stroke-linecap="round"/>
          <path d="M386 360 L418 420 L387 420 L346 378" fill="#f6f2f2" opacity="0.8"/>
          <path d="M392 360 L450 420 L422 420 L366 378" fill="#f6f2f2" opacity="0.8"/>
        </svg>
      </div>

      <div class="text-box">
        <h2 class="headline">하루에 한 송이, 마음 한 다발</h2>
        <p class="desc">
          매일매일 꽃다발과 마음을 전할 수 있으면 좋겠다는 바람에서 시작했습니다.
        </p>
        <p class="desc" style="margin-top:12px;">
          꽃을 고르고, 꽃말에 마음을 담아 편지를 쓰고, 사진도 함께 보내요.
          특별한 날이 아니어도 괜찮아요. 오늘 하루를 꽃 한 다발로 건네봐요.
        </p>
        <button class="cta">시작하기</button>
      </div>
    </div>
  </div>
</body>
</html>
